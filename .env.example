# OpenAI API key — used for resume tailoring via GPT-4o
OPENAI_API_KEY=sk-proj-...

# Slack incoming webhook URL — job alerts are posted here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# How often the main poller runs (minutes); Simplify/Jobright run every 60 min regardless
POLL_INTERVAL_MINUTES=10

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database backend: "sqlite" for local dev, "dynamodb" for AWS production
DB_BACKEND=sqlite

# AWS region for DynamoDB (only used when DB_BACKEND=dynamodb)
AWS_REGION=us-east-1

# DynamoDB table name (only used when DB_BACKEND=dynamodb)
DYNAMODB_TABLE=persift_seen_jobs

# DynamoDB endpoint override — set to http://localhost:8000 for DynamoDB Local, leave blank for real AWS
DYNAMODB_ENDPOINT=

# Postgres connection string (local dev via docker-compose; swap host/creds for RDS in prod)
DATABASE_URL=postgresql://persift:persift@localhost:5432/persift
